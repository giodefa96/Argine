# Copy to .env and fill real values for local dev. NEVER commit .env.
# In staging/production the backend fails fast at startup if any secret is still "changethis".

# local | staging | production
ENVIRONMENT=local
BIND_ADDR=0.0.0.0:8080

# Auth signing key — generate with: openssl rand -base64 32
SECRET_KEY=changethis

# Database
POSTGRES_PASSWORD=changethis
# DATABASE_URL is assembled by docker compose from POSTGRES_PASSWORD. For a direct
# (non-docker) local run the backend already defaults to the local dev DB; override only
# if needed, e.g.:  postgres://argine:<POSTGRES_PASSWORD>@localhost:5432/argine

# CORS: comma-separated explicit allowlist (no wildcard in production)
CORS_ORIGINS=http://localhost:5173
