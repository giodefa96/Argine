# Frontend npm hardening — supply-chain defense at INSTALL time.
# (install/postinstall lifecycle scripts are the most common npm attack vector)

# Pin exact versions — no "^" ranges, so you install exactly what was reviewed.
save-exact=true

# Run the configured audit and refuse engines mismatch.
engine-strict=true
fund=false

# --- Script execution policy --------------------------------------------------
# The strongest mitigation is to NOT run dependency lifecycle scripts at all:
#   ignore-scripts=true
# Caveat: this breaks packages that legitimately build a native binary on install
# (e.g. esbuild, which Vite depends on). Two pragmatic options:
#   1) Keep scripts on, but always install with a committed lockfile via `npm ci`
#      (deterministic) and rely on dependency-review + audit + vetting.
#   2) Switch the frontend to **pnpm**, which blocks install scripts by DEFAULT and
#      lets you allowlist exactly which packages may run them via
#      `onlyBuiltDependencies` in package.json. This is the cleanest answer to
#      "I don't want random postinstall scripts executing." Recommended.
#
# Left commented because it can break the Vite/esbuild toolchain if enabled blindly:
# ignore-scripts=true
